---
// TEMPLATE B · CHAMBER — a room you enter. No descent; you are already at the
// bottom. One zone palette held for the whole page. Four skins.
// The gold skin is the shrine: narrower measure, thread-gold versal, the pall
// as ground, flowers as the only chroma, and nothing moves.
import Layout from "@layouts/Layout.astro";
import TempleFrame from "@layouts/TempleFrame.astro";
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from "@i18n/utils";
import type { ZoneId } from "@temple/zones";
import "@styles/temple.css";

interface Props {
  zone: ZoneId;
  title: string;
  /** Small uppercase line above the title. */
  eyebrow?: string | undefined;
  lead?: string | undefined;
  /** Plate behind the chamber head, if one exists for this zone. */
  plate?: string | undefined;
}

const { zone, title, eyebrow, lead, plate } = Astro.props;
const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
const isGold = zone === "gold";
// Return lands on the descent at this zone's depth, never at the top — and it
// must work without JavaScript, so it is written here, not patched in later.
const descentHref = `${getLocalizedPath("/", lang)}#zona-${zone}`;
---

<Layout title={title} description={lead}>
  <TempleFrame lang={lang} zone={zone} path={Astro.url.pathname}>
    <main class:list={["chamber", isGold && "is-shrine"]}>
      <header class="chamber-head">
        {plate && <img class="head-plate" src={plate} alt="" aria-hidden="true" loading="eager" />}
        {eyebrow && <p class="label">{eyebrow}</p>}
        <h1 class="chamber-title">{title}</h1>
        {lead && <p class="lead">{lead}</p>}
      </header>

      {
        isGold && (
          <div class="flowers" aria-hidden="true">
            <span style="left:12%;top:8%" />
            <span style="left:68%;top:3%;animation-delay:-3s" />
            <span style="left:88%;top:16%;animation-delay:-6s" />
          </div>
        )
      }

      <div class="chamber-body">
        <slot />
      </div>

      <footer class="chamber-foot">
        <a class="back" href={descentHref}>{t("zone.backToDescent")}</a>
      </footer>
    </main>
  </TempleFrame>
</Layout>

<style>
  .chamber {
    padding: var(--page-top) 0 var(--page-bottom);
    /* the centre column sits inside the shaft, not beside it */
    max-width: var(--measure-wide, 62rem);
  }
  .is-shrine {
    max-width: calc(var(--measure-gold) + 6rem);
  }

  .chamber-head {
    position: relative;
    isolation: isolate;
    padding-bottom: var(--s-6);
    margin-bottom: var(--head-gap);
    border-bottom: var(--rule) solid var(--line);
  }
  /* a plate is cut to the head's own box — hard edges, no feather; the
     ground lies over it as one flat layer */
  .head-plate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.2;
    z-index: -1;
  }

  .chamber-title {
    font-size: var(--t-h1);
    letter-spacing: 0.045em;
    text-transform: uppercase;
    font-weight: 400;
    line-height: 1.08;
    margin: 0.42em 0 0;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  /* thread-gold versal — line work, never a field */
  .is-shrine .chamber-title {
    color: var(--gold);
    letter-spacing: 0.08em;
  }

  .chamber-body {
    max-width: var(--measure);
    font-size: var(--t-body);
    line-height: 1.85;
  }
  .is-shrine .chamber-body {
    max-width: var(--measure-gold);
  }
  .chamber-body :global(p) {
    margin: 0 0 1.15em;
    opacity: 0.88;
  }
  .chamber-body :global(h2) {
    font-size: clamp(20px, 2.1vw, 30px);
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 2.2em 0 0.7em;
    opacity: 0.95;
  }
  /* a section opens on a short solid bar — emphasis weight */
  .chamber-body :global(h2)::before {
    content: "";
    display: block;
    width: var(--s-8);
    height: var(--rule-2);
    background: var(--line-strong);
    margin-bottom: var(--s-4);
  }
  /* sub-heads inside a chamber: Slujba's cântări, the Life's chapters and
     testimonies. One step down from h2, then one more; still line work. */
  .chamber-body :global(h3) {
    font-size: 1.15em;
    font-weight: 400;
    font-variant: small-caps;
    letter-spacing: 0.06em;
    line-height: 1.35;
    margin: 2em 0 0.6em;
    color: var(--ochre);
  }
  .chamber-body :global(h4) {
    font-size: 1.02em;
    font-weight: 400;
    font-style: italic;
    letter-spacing: 0.02em;
    line-height: 1.4;
    margin: 1.7em 0 0.5em;
    opacity: 0.95;
  }
  /* Rubrics — the service's own instructions (bold-italic in the source) —
     are printed red in a liturgical book. In the shrine that red is the
     living half of the pall palette (#BD639A), lifted one step so it holds
     4.5:1 on the pall ground. */
  .is-shrine .chamber-body :global(strong em),
  .is-shrine .chamber-body :global(em strong) {
    color: var(--rubric);
    font-weight: 400;
  }
  .is-shrine .chamber-body :global(h3) {
    color: var(--gold);
  }
  .chamber-body :global(h2 + h3),
  .chamber-body :global(h3 + h4) {
    margin-top: 0.8em;
  }

  /* verse with hard line breaks: keep each line whole where it fits, wrap
     cleanly where it does not */
  .chamber-body :global(p) {
    overflow-wrap: break-word;
  }

  .chamber-body :global(blockquote) {
    margin: 1.8em 0;
    padding-left: var(--s-5);
    border-left: var(--rule-2) solid var(--line-strong);
    font-style: italic;
    font-size: var(--t-quote);
    opacity: 0.9;
  }
  /* the reset strips markers; lists in a chamber are real lists */
  .chamber-body :global(ul),
  .chamber-body :global(ol) {
    margin: 0 0 1.3em;
    padding-left: 1.4em;
    opacity: 0.88;
  }
  .chamber-body :global(ul) {
    list-style: disc;
  }
  .chamber-body :global(ol) {
    list-style: decimal;
  }
  .chamber-body :global(ul ul) {
    list-style: circle;
    margin: 0.4em 0 0;
  }
  .chamber-body :global(li) {
    margin-bottom: 0.5em;
    padding-left: 0.2em;
  }
  .chamber-body :global(li::marker) {
    color: var(--ochre);
  }
  .is-shrine .chamber-body :global(li::marker) {
    color: var(--gold);
  }
  .chamber-body :global(li > p) {
    margin-bottom: 0.4em;
  }

  /* tables (Istoria's abbots): full measure, ruled, numbers aligned. On a
     phone the table scrolls inside itself, never the page. */
  .chamber-body :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-collapse: collapse;
    margin: 1.6em 0 2em;
    font-size: 0.94em;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
  .chamber-body :global(th),
  .chamber-body :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.35em 0.8em;
    border-bottom: var(--rule) solid var(--line);
  }
  .chamber-body :global(th:first-child),
  .chamber-body :global(td:first-child) {
    padding-left: 0;
  }
  .chamber-body :global(th) {
    font-weight: 400;
    font-size: 0.82em;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ochre);
    border-bottom: var(--rule-2) solid var(--line-strong);
  }
  @media (max-width: 767px) {
    .chamber-body :global(th) {
      letter-spacing: 0.1em;
    }
    .chamber-body :global(th),
    .chamber-body :global(td) {
      padding: 0.35em 0.55em;
    }
  }
  .chamber-body :global(td) {
    opacity: 0.9;
  }

  .chamber-body :global(hr) {
    border: 0;
    height: var(--rule);
    width: 100%;
    margin: var(--s-8) 0;
    background: var(--line);
  }
  /* CHRONOLOGY — a ruled table of dates. The date is a label in a fixed
     column, the event reads beside it; a hairline under every entry, the
     emphasis rule over the first. On a phone the date stands above. */
  .chamber-body :global(dl.chronology) {
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr);
    column-gap: var(--s-5);
    margin: var(--s-6) 0 var(--s-8);
    border-top: var(--rule-2) solid var(--line-strong);
    font-variant-numeric: tabular-nums;
  }
  .chamber-body :global(dl.chronology dt),
  .chamber-body :global(dl.chronology dd) {
    margin: 0;
    padding: var(--s-3) 0;
    border-bottom: var(--rule) solid var(--line);
    min-width: 0;
  }
  .chamber-body :global(dl.chronology dt) {
    font-size: 13px;
    /* the same line box as the event, so the two first lines share a baseline */
    line-height: calc(var(--t-body) * 1.7);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ochre);
  }
  .chamber-body :global(dl.chronology dt strong) {
    font-weight: 400;
  }
  .chamber-body :global(dl.chronology dd) {
    line-height: 1.7;
    opacity: 0.88;
    overflow-wrap: break-word;
  }
  @media (max-width: 599px) {
    .chamber-body :global(dl.chronology) {
      grid-template-columns: minmax(0, 1fr);
    }
    .chamber-body :global(dl.chronology dt) {
      padding-bottom: 0;
      border-bottom: 0;
    }
    .chamber-body :global(dl.chronology dd) {
      padding-top: var(--s-1);
    }
  }

  /* FIGURE — a plate set into the wall: square, flat, no shadow. The caption
     is a label, cut off from the text by a hairline. */
  .chamber-body :global(figure) {
    margin: var(--s-6) 0 var(--s-8);
  }
  .chamber-body :global(figure img) {
    display: block;
    margin: 0;
    border-radius: var(--radius);
  }
  .chamber-body :global(figcaption) {
    margin-top: var(--s-3);
    padding-top: var(--s-3);
    border-top: var(--rule) solid var(--line);
    font-size: 13px;
    line-height: 1.6;
    letter-spacing: 0.06em;
    opacity: 0.72;
    max-width: var(--measure);
  }

  .chamber-body :global(a) {
    color: var(--ochre);
  }
  .chamber-body :global(img) {
    width: 100%;
    height: auto;
    margin: 2em 0;
  }

  /* the relics are buried in fresh flowers — the living half of the palette */
  .flowers span {
    position: absolute;
    width: var(--s-2);
    height: var(--s-2);
    background: var(--flower);
    animation: drift 9s ease-in-out infinite;
  }
  .flowers {
    position: relative;
    height: 0;
  }
  @keyframes drift {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-9px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flowers span {
      animation: none;
    }
  }

  .chamber-foot {
    margin-top: var(--s-10);
    padding-top: var(--s-4);
    border-top: var(--rule) solid var(--line);
  }
  .back {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: var(--t-label);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ochre);
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
    text-underline-offset: 6px;
  }
</style>
