---
// TEMPLATE A · STRATUM — home only. The whole site in one scroll.
// A descent through strata, not a page stack: cave → green church → river.
// Scrolling is descending into shade, so the page gets DARKER downward,
// inverting the usual web instinct. ARCHITECTURE.md.
//
// One column, one gutter, one rhythm for all four strata (--col-*, --stratum-pad,
// --head-gap below). Every stratum is built the same way, top to bottom:
//   head   numeral · zone label → title → lead
//   act    the stratum's one job (Rock: the well · Green: the hours ·
//          Gold: the door · River: the four practical tiles)
//   index  the chambers behind it, as ruled rows
//
// The horizontal reading of the same four zones is kept at /walk.
import Layout from "@layouts/Layout.astro";
import Stratum from "@components/descent/Stratum.astro";
import Well from "@components/descent/Well.astro";
import ShrineDoor from "@components/descent/ShrineDoor.astro";
import DescentRail from "@components/temple/DescentRail.astro";
import CalendarRail from "@components/temple/CalendarRail.astro";
import Gate from "@components/descent/Gate.astro";
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from "@i18n/utils";
import { getRecentPosts } from "@data/posts";
import { homeHours, serviceText } from "@data/schedule";
import { zoneById } from "@temple/zones";
import { publicAsset } from "@utils/paths";
import "@styles/temple.css";
import Seal from "@components/marks/Seal.astro";
import Icon from "@components/marks/Icon.astro";

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
const posts = await getRecentPosts(lang, 3);
const plate = (name: string) => publicAsset(`/plates/${name}.webp`);
const href = (path: string) => getLocalizedPath(path, lang);

// the hours and the chronicle have their own blocks; every other green
// chamber is listed under them
const greenChambers = zoneById.green.pages.filter((p) => p.href !== "/slujbe" && p.href !== "/posts");
const goldChambers = zoneById.gold.pages;
// the lit door opens onto the first chamber behind it (Cuviosul Macarie)
const doorHref = goldChambers[0] ? href(goldChambers[0].href) : undefined;
const riverPages = zoneById.river.pages;
---

<Layout>
  <div class="descent">
    <DescentRail lang={lang} current={null} />

    <main class="descent-main">
      {
        /* ═══ I · ROCK — origin, silence, subtraction. movement: down ═══
          The first screen: seal, title, lead and the one act — the well. */
      }
      <Stratum zone="rock" id="zona-rock" plate={plate("rock")} opacity={0.42} eager labelledby="rock-head">
        {/* 388px source; drawn at ≤112 css px, so 1×/2×/3× covers every phone */}
        <Seal class="seal" size={112} loading="eager" />
        <header class="head">
          <p class="label"><span class="num">{zoneById.rock.numeral}</span><span>{t("zone.rock")}</span></p>
          <h1 id="rock-head" class="stratum-title">{t("home.descentTitle")}</h1>
          <p class="lead">{t("home.descentLead")}</p>
        </header>

        {
          /* The well is the pomelnic: a shaft you lower names down. Its mouth is
            the action; the shaft opens directly under it, on the column's
            centre axis, and runs out of the stratum through the gate. */
        }
        <a class="act well-mouth" href={href("/pomelnic")}>
          <span class="act-text">
            <span class="act-label">{t("zone.pomelnic")}</span>
            <span class="act-hint">{t("home.wellHint")}</span>
          </span>
          <span class="act-arrow"><Icon name="arrow-down" size={20} /></span>
        </a>
        <div class="well-run"><Well x="50%" mouthAt="4px" /></div>
      </Stratum>

      {/* gate — a cut in the cliff; the shaft stays tight */}
      <Gate width="narrow" />

      {/* ═══ II · GREEN — the living monastery. the strata widen ═══ */}
      <Stratum
        zone="green"
        id="zona-green"
        plate={plate("green")}
        plateSlot="band-top"
        focus="50% 38%"
        opacity={0.88}
        reveal
        labelledby="green-head">
        <header class="head">
          <p class="label"><span class="num">{zoneById.green.numeral}</span><span>{t("zone.green")}</span></p>
          <h2 id="green-head" class="stratum-title">{t("home.greenTitle")}</h2>
          <p class="lead">{t("home.greenLead")}</p>
        </header>

        <div class="green-grid">
          <section class="block" aria-labelledby="ceasuri">
            <h3 id="ceasuri" class="block-head">{t("zone.slujbe")}</h3>
            <p class="block-meta">{t("schedule.monWed")}</p>
            <dl class="hours">
              {
                homeHours.map((h) => (
                  <div class="hour">
                    <dt>{h.time}</dt>
                    <dd>{serviceText(h.name, lang)}</dd>
                  </div>
                ))
              }
            </dl>
            <a class="more" href={href("/slujbe")}>{t("home.fullSchedule")}</a>
          </section>

          <section class="block" aria-labelledby="cronica-head">
            <h3 id="cronica-head" class="block-head">{t("zone.cronica")}</h3>
            {
              posts.length > 0 ? (
                <ul class="post-list">
                  {posts.map((post) => (
                    <li>
                      <a href={href(`/posts/${post.slug}`)}>
                        <time datetime={post.isoDate}>{post.date}</time>
                        <span class="post-title">{post.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="empty">{t("home.noPosts")}</p>
              )
            }
            <a class="more" href={href("/posts")}>{t("home.allNews")}</a>
          </section>
        </div>

        <ul class="index index-green">
          {
            greenChambers.map((p) => (
              <li>
                <a href={href(p.href)}>{t(p.labelKey)}</a>
              </li>
            ))
          }
        </ul>
      </Stratum>

      {
        /* ═══ III · GOLD & PALL — the hinge. you do not pass through. ═══
          Not a destination you navigate to — something you walk past on the
          way down, exactly as the relics sit inside the church you pass on
          the way to the Nistru. Inward and downward differ only here.
          The door stands off the axis, to the right of the words. */
      }
      <Stratum zone="gold" id="zona-gold" reveal labelledby="hinge-head">
        <ShrineDoor plate={plate("gold-door")} href={doorHref}>
          <Fragment slot="head">
            <p class="label gold-label">
              <span class="num">{zoneById.gold.numeral}</span><span>{t("zone.gold")}</span>
            </p>
            <h2 id="hinge-head" class="stratum-title gold-title">{t("home.shrineTitle")}</h2>
          </Fragment>
          <blockquote slot="quote" class="acatist">{t("home.shrineQuote")}</blockquote>
          <ul class="index index-gold">
            {
              goldChambers.map((p) => (
                <li>
                  <a href={href(p.href)}>{t(p.labelKey)}</a>
                </li>
              ))
            }
          </ul>
        </ShrineDoor>
      </Stratum>

      {/* gate — the gorge opens; sky enters for the first time */}
      <Gate width="full" />

      {
        /* ═══ IV · RIVER — the only wide horizon. down stops here. ═══
          Practical: four tiles, read at a glance; the photograph of the
          water closes the descent beneath them. */
      }
      <Stratum
        zone="river"
        id="zona-river"
        plate={plate("river")}
        plateSlot="band-bottom"
        focus="50% 58%"
        reveal
        labelledby="river-head">
        <header class="head">
          <p class="label river-label-head">
            <span class="num">{zoneById.river.numeral}</span><span>{t("zone.river")}</span>
          </p>
          <h2 id="river-head" class="stratum-title">{t("home.riverTitle")}</h2>
          <p class="lead">{t("home.riverLead")}</p>
        </header>

        {/* the single horizontal on the site */}
        <ul class="river-row">
          {
            riverPages.map((p) => (
              <li>
                <a href={href(p.href)}>
                  <span class="tile-label">{t(p.labelKey)}</span>
                  <span class="tile-arrow">
                    <Icon name="arrow-right" size={16} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </Stratum>
    </main>

    <CalendarRail lang={lang} />
  </div>
</Layout>

<script>
  // Mark the stratum you are in, so the left rail reads as a position: the
  // stratum that crosses the middle of the screen is the current one (a
  // ratio threshold never fires on strata taller than the viewport).
  const strata = document.querySelectorAll<HTMLElement>(".descent-main [data-zone]");
  const marks = new Map<string, Element>();

  document.querySelectorAll<HTMLElement>(".stratum-entry").forEach((entry) => {
    const zone = Array.from(entry.classList)
      .find((c) => c.startsWith("is-"))
      ?.slice(3);
    if (zone) marks.set(zone, entry);
  });

  if ("IntersectionObserver" in window && strata.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const zone = (e.target as HTMLElement).dataset.zone;
          if (zone) marks.get(zone)?.classList.toggle("is-current", e.isIntersecting);
        }
      },
      { rootMargin: "-50% 0px -50% 0px", threshold: 0 },
    );

    strata.forEach((s) => observer.observe(s));
  }

  // The descent, felt on a phone: each stratum settles into place as you
  // reach it. Opacity and a short transform only; nothing at all under
  // reduced motion (the CSS never hides anything there). Anything already on
  // screen, or anything a hash jumps to, is shown at once.
  const revealables = document.querySelectorAll<HTMLElement>("[data-reveal]");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!still && "IntersectionObserver" in window) {
    const reveal = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add("is-revealed");
          reveal.unobserve(e.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0 },
    );
    revealables.forEach((el) => reveal.observe(el));
  } else {
    revealables.forEach((el) => el.classList.add("is-revealed"));
  }

  // Return from a chamber lands at that zone's depth (#zona-<id>), never the
  // top. Nothing to do here beyond letting the hash land — but the descent is
  // tall, so honour reduced motion.
  if (location.hash.startsWith("#zona-")) {
    const target = document.querySelector<HTMLElement>(location.hash);
    target?.querySelectorAll("[data-reveal]").forEach((el) => el.classList.add("is-revealed"));
    if (target?.matches("[data-reveal]")) target.classList.add("is-revealed");
    target?.scrollIntoView({ behavior: "auto", block: "start" });
  }
</script>

<style>
  /* ─── the frame and the column ───────────────────────────────────────
     Same frame as every chamber (TempleFrame): rail | centre | rail, from
     SOLID's tokens. Inside the centre, one column for all four strata. */
  .descent {
    /* one column, one gutter */
    --col-max: var(--centre-max, 1200px);
    --col-pad: var(--frame-pad, 16px);
    /* one vertical rhythm */
    --stratum-pad: var(--s-9, 64px);
    --head-gap: var(--s-8, 48px);
    --block-gap: var(--s-8, 48px);
    /* the well and the door, snapped to the field */
    --well-w: var(--s-9, 64px);
    --door-w: var(--s-11, 96px);

    display: grid;
    grid-template-columns: var(--rail-l, 208px) minmax(0, var(--centre-max, 1200px)) var(--rail-r, 240px);
    justify-content: center;
    gap: 0 var(--frame-gap, var(--s-8));
    padding: 0 var(--frame-pad, var(--s-7));
    background: var(--rock-deep);
    color: var(--parchment);
  }
  .descent-main {
    min-width: 0;
  }
  @media (min-width: 600px) {
    .descent {
      --stratum-pad: var(--s-10, 80px);
      --door-w: 192px;
    }
  }
  @media (min-width: 1101px) {
    .descent {
      /* inside the centre field the strata are framed by their own ground */
      --col-pad: var(--s-9, 64px);
      --stratum-pad: var(--s-11, 96px);
      --head-gap: var(--s-9, 64px);
      --well-w: var(--s-11, 96px);
      --door-w: 240px;
    }
  }
  @media (max-width: 1360px) {
    .descent {
      grid-template-columns: var(--rail-l, 208px) minmax(0, 1fr);
    }
  }
  @media (max-width: 1100px) {
    /* the rail is a drawer; the strata go full bleed */
    .descent {
      grid-template-columns: minmax(0, 1fr);
      padding: 0;
    }
  }

  /* scroll reveal — phones and tablets, where the descent is the whole
     screen. Short and crisp: 8px, one duration, no overshoot. */
  @media (max-width: 1100px) and (prefers-reduced-motion: no-preference) {
    :global(html.js .descent [data-reveal]) {
      opacity: 0;
      transform: translateY(var(--s-2, 8px));
      transition:
        opacity var(--dur-3, 220ms) var(--ease-out, ease-out),
        transform var(--dur-3, 220ms) var(--ease-out, ease-out);
    }
    :global(html.js .descent [data-reveal].is-revealed) {
      opacity: 1;
      transform: none;
    }
  }

  /* below 1360px the calendar is not a rail but a fold after the descent:
     on the same column as the strata, the foundation course above the
     footer. */
  @media (max-width: 1360px) {
    .descent > :global(.rail-right) {
      margin: 0;
      padding: var(--s-4, var(--s-4)) var(--col-pad) var(--s-8, var(--s-8));
      border-top: 0;
    }
  }
  @media (min-width: 1101px) and (max-width: 1360px) {
    /* beside the left rail: the fold sits under the strata, so it takes the
       strata's inner gutter too */
    .descent > :global(.rail-right) {
      padding-left: var(--col-pad);
      padding-right: var(--col-pad);
    }
  }

  /* ─── the head: label → title → lead, identical in every stratum ───── */
  .label {
    gap: var(--s-3, var(--s-3));
    margin: 0;
  }
  .num {
    font-variant-numeric: tabular-nums;
  }
  .stratum-title {
    margin: var(--s-4, var(--s-4)) 0 0;
    overflow-wrap: break-word;
  }
  .lead {
    margin: var(--s-5, var(--s-5)) 0 0;
  }
  @media (max-width: 1100px) {
    /* "CASA DUMNEZEIEȘTII" is one word long; it must fit 320 css px */
    .stratum-title {
      font-size: clamp(26px, 8vw, 52px);
    }
  }
  @media (max-width: 599px) {
    /* the first screen holds seal, title, lead and the well on a 360×780
       phone; the lead steps down one size to make that true */
    .lead {
      font-size: 18px;
      line-height: 1.6;
    }
  }

  /* ─── I · ROCK ──────────────────────────────────────────────────────── */
  .seal {
    display: block;
    width: var(--s-9, 64px);
    height: auto;
    margin-bottom: var(--s-6, var(--s-6));
  }
  @media (min-width: 1101px) {
    .seal {
      width: var(--s-11, 96px);
    }
  }

  /* the act — one per stratum, never mistaken for text: a solid slab, a
     hairline frame, the label in capitals and a square arrow box */
  .act {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4, var(--s-4));
    min-height: var(--s-10, 80px);
    padding: var(--s-4, var(--s-4)) var(--s-4, var(--s-4)) var(--s-4, var(--s-4)) var(--s-5, var(--s-5));
    color: var(--parchment);
    text-decoration: none;
    background: var(--rock-deep);
    border: var(--rule, 1px) solid rgb(244 239 228 / 28%);
    transition:
      background var(--dur-1, 120ms) var(--ease-out, ease-out),
      border-color var(--dur-1, 120ms) var(--ease-out, ease-out),
      transform var(--dur-1, 120ms) var(--ease-out, ease-out);
  }
  .act:hover {
    background: var(--hinge-ground);
    border-color: var(--ochre);
  }
  .act-text {
    display: grid;
    gap: var(--s-1, var(--s-1));
    min-width: 0;
  }
  .act-label {
    font-size: 15px;
    line-height: 1.3;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  .act-hint {
    font-size: 16px;
    line-height: 1.45;
    opacity: 0.8;
  }
  .act-arrow {
    flex: none;
    display: grid;
    place-items: center;
    width: var(--tap, 48px);
    height: var(--tap, 48px);
    border: var(--rule, 1px) solid rgb(244 239 228 / 40%);
    font-size: 20px;
    line-height: 1;
  }

  /* the well mouth: the act sits ON the shaft. you lower it. */
  .well-mouth {
    margin-top: var(--head-gap);
  }
  .well-mouth:hover {
    transform: translateY(var(--s-1, 4px));
  }
  /* the shaft runs behind the words, not across them: inside the stratum's
     .wrap (its own stacking context) -1 sits under the text, over the plate */
  .well-run :global(.well) {
    z-index: -1;
  }
  .well-run {
    position: relative;
    height: var(--s-11, 96px);
  }
  @media (min-width: 1101px) {
    .well-run {
      height: var(--s-12, 128px);
    }
  }

  /* ─── II · GREEN ───────────────────────────────────────────────────── */
  .green-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--block-gap);
    margin-top: var(--head-gap);
  }
  @media (min-width: 768px) {
    .green-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-8, var(--s-8));
    }
  }

  /* a block head is a table head: capitals in the text colour, closed by
     the emphasis rule; the rows below are hairlines */
  .block-head {
    margin: 0;
    padding-bottom: var(--s-3, var(--s-3));
    border-bottom: var(--rule-2, 2px) solid var(--line-strong);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }
  .block-meta {
    margin: 0;
    padding: var(--s-3, var(--s-3)) 0;
    border-bottom: var(--rule, 1px) solid var(--line);
    font-size: var(--t-label);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .hours {
    margin: 0;
  }
  .hour {
    display: grid;
    grid-template-columns: var(--s-10, 80px) minmax(0, 1fr);
    align-items: baseline;
    border-bottom: var(--rule, 1px) solid var(--line);
  }
  .hours dt,
  .hours dd {
    margin: 0;
    padding: var(--s-3, var(--s-3)) 0;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
  .hours dt {
    letter-spacing: 0.06em;
  }
  .hours dd {
    opacity: 0.88;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-list a {
    display: grid;
    gap: var(--s-1, var(--s-1));
    padding: var(--s-4, var(--s-4)) 0;
    border-bottom: var(--rule, 1px) solid var(--line);
    text-decoration: none;
    color: inherit;
    transition: color var(--dur-1, 120ms) var(--ease-out, ease-out);
  }
  .post-list a:hover .post-title {
    color: var(--ochre);
  }
  .post-list time {
    font-size: var(--t-label);
    line-height: 1.4;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .post-title {
    font-size: 17px;
    line-height: 1.45;
  }
  .empty {
    margin: 0;
    padding: var(--s-4, var(--s-4)) 0;
    border-bottom: var(--rule, 1px) solid var(--line);
    opacity: 0.6;
    font-style: italic;
  }

  /* "more" closes a block: a full-width row with its arrow, not loose text */
  .more {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4, var(--s-4));
    min-height: var(--tap, 48px);
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ochre);
    text-decoration: none;
  }
  .more::after,
  .index a::after {
    content: "";
    flex: none;
    inline-size: 16px;
    block-size: 16px;
    background: currentColor;
    mask: var(--icon-arrow-right) center / contain no-repeat;
    transition: transform var(--dur-1, 120ms) var(--ease-out, ease-out);
  }
  .more:hover::after,
  .index a:hover::after {
    transform: translateX(var(--s-1, 4px));
  }

  /* the chambers behind a stratum: ruled rows, the same in every zone */
  .index {
    list-style: none;
    margin: var(--block-gap) 0 0;
    padding: 0;
    border-top: var(--rule-2, 2px) solid var(--line-strong);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: var(--s-8, var(--s-8));
  }
  /* a row of the grid is one height: every cell's rule lands on one line */
  .index li {
    display: flex;
  }
  .index a {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4, var(--s-4));
    min-height: var(--tap, 48px);
    padding: var(--s-2, var(--s-2)) 0;
    border-bottom: var(--rule, 1px) solid var(--line);
    color: inherit;
    text-decoration: none;
    font-size: 17px;
    line-height: 1.4;
  }
  .index a::after {
    color: var(--ochre);
  }
  .index a:hover {
    color: var(--ochre);
  }
  @media (min-width: 768px) {
    .index-green {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1361px) {
    .index-green {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ─── III · GOLD, the hinge ────────────────────────────────────────── */
  .gold-label,
  .gold-title {
    color: var(--gold);
  }
  /* a narrower title, so the door never covers it beside the text */
  .gold-title {
    letter-spacing: 0.06em;
  }
  @media (min-width: 600px) {
    .gold-title {
      font-size: clamp(28px, 3vw, 40px);
    }
  }
  .acatist {
    margin: 0;
    padding-left: var(--s-5, var(--s-5));
    border-left: var(--rule-2, 2px) solid var(--gold);
    font-style: italic;
    font-size: var(--t-quote);
    line-height: 1.6;
    opacity: 0.9;
  }
  /* the door's grid spaces quote and links (one row gap); no margin here */
  .index-gold {
    margin-top: 0;
  }
  .index-gold a,
