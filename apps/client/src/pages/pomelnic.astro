---
// THE WELL — Zone I. The pomelnic has exactly one home: the shaft, on the
// centre axis. A subtractive object, like the cave: you lower names down it.
// ARCHITECTURE.md § What this settles.
import Layout from "@layouts/Layout.astro";
import TempleFrame from "@layouts/TempleFrame.astro";
import PrayerRequestForm from "@components/PrayerRequestForm.astro";
import { getLocaleFromUrl, useTranslations } from "@i18n/utils";
import "@styles/temple.css";

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t("pomelnic.title")}>
  <TempleFrame lang={lang} zone="rock" path={Astro.url.pathname}>
    <main class="well-page" id="pomelnic-form">
      <header class="well-head">
        <p class="label">{t("pomelnicPage.eyebrow")}</p>
        <h1 class="stratum-title">{t("pomelnic.title")}</h1>
        <p class="lead">{t("pomelnicPage.lead")}</p>
      </header>

      {/* the shaft: the form sits inside it, not beside it */}
      <div class="shaft">
        <div class="shaft-mouth" aria-hidden="true"></div>
        <div class="form-well">
          <PrayerRequestForm idPrefix="pomelnic-page" lang={lang} />
        </div>
        <div class="shaft-water" aria-hidden="true"></div>
      </div>
    </main>
  </TempleFrame>
</Layout>

<style>
  .well-page {
    padding: var(--page-top) 0 var(--page-bottom);
    max-width: 48rem;
    margin: 0 auto;
  }
  .well-head {
    text-align: center;
    margin-bottom: var(--head-gap);
  }
  .well-head .label {
    justify-content: center;
  }
  .well-head .label::after {
    display: none;
  }
  .well-head .lead {
    margin: 1em auto 0;
  }

  /* The shaft: two emphasis walls, a flat recessed fill, the ochre mouth
     as the one heavy bar on the page, and still water as a flat dark floor. */
  .shaft {
    --shaft-pad: var(--s-7);
    position: relative;
    padding: 0 var(--shaft-pad);
    border-left: var(--rule-2) solid rgb(244 239 228 / 32%);
    border-right: var(--rule-2) solid rgb(244 239 228 / 32%);
    background: var(--well-wall);
  }
  .shaft-mouth {
    height: var(--bar-2);
    background: var(--ochre);
    /* the mouth spans the walls: it is laid across them */
    margin: 0 calc((var(--shaft-pad) + var(--rule-2)) * -1) var(--s-8);
  }
  .shaft-water {
    height: var(--s-10);
    margin: var(--s-8) calc(var(--shaft-pad) * -1) 0;
    background: var(--night);
    border-top: var(--rule) solid rgb(244 239 228 / 32%);
  }
  @media (max-width: 599px) {
    .shaft {
      --shaft-pad: var(--s-4);
    }
    .shaft-water {
      height: var(--s-8);
    }
  }

  /* the form is Tailwind-skinned for a bright page; in the shaft it is dark */
  .form-well :global(label) {
    color: var(--parchment);
    opacity: 0.9;
  }
  .form-well :global(input),
  .form-well :global(textarea) {
    background: var(--well-floor);
    border-color: rgb(244 239 228 / 40%);
    color: var(--parchment);
    border-radius: 0;
    box-shadow: none;
  }
  .form-well :global(input::placeholder),
  .form-well :global(textarea::placeholder) {
    color: rgb(244 239 228 / 40%);
  }
  .form-well :global(input:focus),
  .form-well :global(textarea:focus) {
    border-color: var(--ochre);
    outline: var(--rule) solid var(--ochre);
    outline-offset: 0;
    box-shadow: none;
  }
  .form-well :global(button) {
    border-radius: 0;
    background: var(--ochre);
    color: var(--ink);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .form-well :global(p) {
    color: var(--parchment);
  }
</style>
