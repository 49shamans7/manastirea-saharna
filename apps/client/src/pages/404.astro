---
// NOT FOUND — Zone I, the rock. A wrong turn underground: the rails stay, so
// the way back is always in view. Same stratum type as every other page.
import Layout from "@layouts/Layout.astro";
import TempleFrame from "@layouts/TempleFrame.astro";
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from "@i18n/utils";
import "@styles/temple.css";

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t("notFound.title")}>
  <TempleFrame lang={lang} zone="rock" path={Astro.url.pathname}>
    <main class="lost">
      <p class="label">{t("notFound.eyebrow")}</p>
      <h1 class="stratum-title">{t("notFound.title")}</h1>
      <p class="lead">{t("notFound.description")}</p>
      <div class="ways">
        <a class="way" href={getLocalizedPath("/", lang)}>{t("notFound.home")}</a>
        <a class="way" href={getLocalizedPath("/pomelnic", lang)}>{t("notFound.pomelnic")}</a>
      </div>
    </main>
  </TempleFrame>
</Layout>

<style>
  .lost {
    padding: var(--s-12) 0 var(--s-12);
    max-width: 40rem;
  }
  .lost .lead {
    margin-top: var(--s-4);
  }
  .ways {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-8);
  }
  .way {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--s-5);
    border: var(--rule) solid rgb(244 239 228 / 40%);
    color: var(--parchment);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition:
      border-color var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out);
  }
  .way:first-child {
    border: var(--rule-2) solid var(--ochre);
  }
  .way:hover {
    background: rgb(244 239 228 / 8%);
  }
</style>
