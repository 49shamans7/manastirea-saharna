---
import type { Locale } from "@i18n";
import { getLocalizedPath, useTranslations } from "@i18n/utils";
import Icon from "@components/marks/Icon.astro";

type Props = {
  lang: Locale;
};

const { lang } = Astro.props;
const t = useTranslations(lang);
// The footer carries the descent too — every zone reachable from the bottom
// of any page, and every link a real route.
const footerLinks = [
  { key: "zone.istoria", href: getLocalizedPath("/istoria", lang) },
  { key: "zone.obstea", href: getLocalizedPath("/obstea", lang) },
  { key: "zone.cronica", href: getLocalizedPath("/posts", lang) },
  { key: "zone.macarie", href: getLocalizedPath("/macarie", lang) },
  { key: "nav.serviceSchedule", href: getLocalizedPath("/slujbe", lang) },
  { key: "nav.directions", href: getLocalizedPath("/cum-de-ajuns", lang) },
  { key: "zone.cazare", href: getLocalizedPath("/cazare", lang) },
  { key: "nav.pomelnic", href: getLocalizedPath("/pomelnic", lang) },
  { key: "nav.contact", href: getLocalizedPath("/contact", lang) },
  { key: "nav.donations", href: getLocalizedPath("/donations", lang) },
  { key: "search.title", href: getLocalizedPath("/cautare", lang) },
] as const;
const socialLinks = [
  { key: "social.youtube", href: "https://www.youtube.com/@manastirea.saharna", icon: "youtube", mark: "" },
  { key: "social.facebook", href: "https://www.facebook.com/ManastireaSaharna/", icon: "text", mark: "f" },
  { key: "social.tiktok", href: "https://www.tiktok.com/@monklife?_r=1&_t=ZS-972uTnfFdwq", icon: "tiktok", mark: "" },
] as const;
---

{/* the lintel: a 4px solid bar closes every page; hairlines divide inside */}
<footer class="footer">
  <div class="frame-wide">
    <p class="title">{t("main.title")}</p>
    <nav class="links" aria-label={t("nav.menu")}>
      {footerLinks.map((item) => <a href={item.href}>{t(item.key)}</a>)}
    </nav>
    <div class="base">
      <p class="copyright">{t("footer.copyright")}</p>
      <nav class="social" aria-label={t("social.label")}>
        {
          socialLinks.map((item) => (
            <a href={item.href} aria-label={t(item.key)} title={t(item.key)} target="_blank" rel="noreferrer">
              {item.icon === "youtube" ? (
                <Icon name="youtube" size={16} />
              ) : item.icon === "tiktok" ? (
                <Icon name="tiktok" size={16} />
              ) : (
                <span aria-hidden="true">{item.mark}</span>
              )}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--s-8) 0;
    border-top: var(--bar) solid var(--ochre);
    background: var(--header);
    color: color-mix(in srgb, var(--parchment) 80%, transparent);
    font-size: 14px;
    line-height: 20px;
  }
  .title {
    margin: 0 0 var(--s-6);
    color: var(--parchment);
    font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 18px;
    line-height: 28px;
    font-weight: 700;
    text-transform: uppercase;
  }

  /* five columns of real routes, ruled off from the title and the base */
  .links {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--s-2) var(--s-5);
    margin-bottom: var(--s-6);
    padding-top: var(--s-5);
    border-top: var(--rule) solid color-mix(in srgb, var(--ochre) 30%, transparent);
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--s-6);
    transition: color var(--dur-1) var(--ease-out);
  }
  .links a:hover {
    color: var(--ochre);
  }

  .base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: var(--s-5);
    border-top: var(--rule) solid color-mix(in srgb, var(--ochre) 30%, transparent);
  }
  .copyright {
    margin: 0;
  }

  /* one joined strip of square cells: neighbours share a hairline */
  .social {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: flex-end;
    margin-left: auto;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    margin-left: calc(-1 * var(--rule));
    border: var(--rule) solid color-mix(in srgb, var(--parchment) 30%, transparent);
    color: color-mix(in srgb, var(--parchment) 85%, transparent);
    font-weight: 700;
    text-decoration: none;
    transition:
      color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }
  .social a:first-child {
    margin-left: 0;
  }
  .social a:hover {
    border-color: var(--ochre);
    color: var(--ochre);
  }

  @media (width < 64rem) {
    .links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 0;
    }
    .links a {
      min-height: var(--tap);
      font-size: 16px;
      line-height: 24px;
    }
  }
  @media (width < 40rem) {
    .footer {
      padding: var(--s-7) 0 var(--s-6);
    }
    .links {
      grid-template-columns: 1fr;
      padding-top: var(--s-2);
    }
    .links a {
      border-bottom: var(--rule) solid color-mix(in srgb, var(--ochre) 20%, transparent);
    }
    .links a:last-child {
      border-bottom: 0;
    }
    .base {
      flex-direction: column;
      text-align: center;
    }
    .social {
      margin-left: 0;
    }
  }
</style>
