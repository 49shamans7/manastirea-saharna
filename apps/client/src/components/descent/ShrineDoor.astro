---
import Cross from "@components/marks/Cross.astro";
// Zone III has no page of its own. The door IS the zone.
//
// A lit aperture in the wall of the descent, offset from the axis: it stands
// to the right of the words — beside the prayer on a phone (a narrow lit
// slot, one field wide, so the title keeps the full measure and never breaks
// inside a word), beside the whole text on wider screens. It never sits
// under the text, where it read as a page-wide photograph.
//
// slots: head (label + title) · quote (the acatist) · default (chamber links)
interface Props {
  plate?: string | undefined;
  /** the door opens onto the first chamber behind it */
  href?: string | undefined;
}
const { plate, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<div class="door">
  <div class="door-head"><slot name="head" /></div>
  <div class="door-quote"><slot name="quote" /></div>
  <Tag class="door-panel" href={href} tabindex={href ? -1 : undefined} aria-hidden="true">
    {plate && <img src={plate} alt="" class="door-plate" loading="lazy" decoding="async" />}
    <span class="flower" style="left:16%;top:24%"></span>
    <span class="flower" style="left:72%;top:64%;animation-delay:-3s"></span>
    <span class="flower" style="left:32%;top:80%;animation-delay:-6s"></span>
    <Cross fill="var(--gold)" />
  </Tag>
  <div class="door-body"><slot /></div>
</div>

<style>
  /* phone: the head takes the full column; the door stands beside the
     prayer, one field wide; the chamber links take the full column below. */
  .door {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--door-w, 96px);
    grid-template-areas:
      "head head"
      "quote door"
      "body body";
    column-gap: var(--s-5, var(--s-5));
    row-gap: var(--head-gap, var(--s-8));
    align-items: start;
  }
  .door-head {
    grid-area: head;
    min-width: 0;
  }
  .door-quote {
    grid-area: quote;
    min-width: 0;
    max-width: var(--measure-gold);
  }
  .door-body {
    grid-area: body;
    min-width: 0;
    max-width: var(--measure-gold);
  }

  .door-panel {
    grid-area: door;
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1.62;
    overflow: hidden;
    background: var(--shrine-ground);
    border: var(--rule, 1px) solid rgb(192 169 116 / 45%);
  }
  /* the inner frame: a second hairline, one step in */
  .door-panel::after {
    content: "";
    position: absolute;
    inset: var(--s-2, var(--s-2));
    border: var(--rule, 1px) solid rgb(192 169 116 / 22%);
    pointer-events: none;
  }
  a.door-panel:hover::after {
    border-color: var(--gold);
  }
  .door-plate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
    filter: grayscale(1);
  }
  .door-panel svg {
    position: relative;
    width: 44%;
    height: auto;
  }

  /* stillness — nothing moves in a gold chamber except the flowers.
     (temple.css stops them under reduced motion) */
  .flower {
    position: absolute;
    z-index: 1;
    width: var(--s-2, 8px);
    height: var(--s-2, 8px);
    background: var(--flower);
    animation: drift 9s linear infinite;
  }
  @keyframes drift {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(calc(-1 * var(--s-2, 8px)));
    }
  }

  /* wider: the door beside the whole text, from the label down */
  @media (min-width: 600px) {
    .door {
      grid-template-columns: minmax(0, 1fr) var(--door-w, 240px);
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        "head door"
        "quote door"
        "body door";
      column-gap: var(--s-8, var(--s-8));
    }
  }
</style>
